<!DOCTYPE html>
<html lang="{{ page.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ config.title }}{% endblock %}</title>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+SC:wght@400;500;600;700&family=LXGW+WenKai+TC:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">

</head>
<body>
  <!-- 固定背景图 -->
  <div class="site-bg"></div>
  {% block ink_intro %}{% endblock %}

  <!-- 导航栏 -->
  <nav class="nav" id="nav">
    <a href="/" class="nav-brand">{{ config.title }}</a>
    <ul class="nav-links">
      <li><a href="/">首页</a></li>
      <li><a href="/archives/">归档</a></li>
      <li><a href="/projects/">项目</a></li>
      <li><a href="/tags/">标签</a></li>
      <li><a href="/about/">关于</a></li>
    </ul>
  </nav>

  {% block banner %}
    <header class="banner tall">
      <div class="avatar-box">
        <img src="/images/avatar.jpg" alt="avatar">
      </div>
      <div class="banner-bg">
        <img src="/images/banner.png" alt="" style="width:100%;height:100%;object-fit:cover;object-position:center 40%;">
      </div>
      <div class="banner-mask"></div>
      <div class="banner-content">
        <h1 class="banner-title">{{ config.title }}</h1>
        <p class="banner-subtitle"><span id="typed">{{ config.description or '记录生活 · 分享技术' }}</span><span class="typed-cursor"></span></p>
      </div>
      <div class="scroll-down" onclick="document.querySelector('.board').scrollIntoView({behavior:'smooth'})">
        <div class="arrow"></div>
      </div>
    </header>
  {% endblock %}

  <!-- 白色面板 -->
  <main class="board">
    {% block content %}{% endblock %}
  </main>

  {# 随正文滚动的两侧浮层（资料栏/项目栏）。
     放在 .board 外面：.board 有 backdrop-filter，会成为后代绝对/固定定位元素的
     包含块，而且它的 overflow:hidden 还会把伸到面板外侧的部分裁掉。
     定位上下文的建立交给首页模板里的 .page-body。 #}
  {% block overlays %}{% endblock %}

  <footer class="footer">
    <p>&copy; 2026 {{ config.title }} · {{ config.author }}</p>
  </footer>

  <button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

    <script src="/js/fluid.js" defer></script>


</body>
</html>
