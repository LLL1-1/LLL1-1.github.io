{% extends '_layout.njk' %}

{% block title %}{{ page.title }} | {{ config.title }}{% endblock %}

{% block banner %}
  <header class="banner small">
    <div class="banner-bg">
      <img src="/images/banner.png" alt="" style="width:100%;height:100%;object-fit:cover;object-position:center 40%;">
    </div>
    <div class="banner-mask"></div>
    <div class="banner-content" style="top:55%;">
      <h1 class="banner-title" style="font-size:2.2em; letter-spacing:4px;">{{ page.title }}</h1>
    </div>
  </header>
{% endblock %}

{% block content %}

  <div class="post-header">
    <div class="index-meta">
      <span>📅 {{ date(page.date, 'YYYY-MM-DD') }}</span>
      {% if page.categories and page.categories.length %}
        {% for cat in page.categories.toArray() %}
          <span class="index-tag">📁 {{ cat.name }}</span>
        {% endfor %}
      {% endif %}
      {% if page.tags and page.tags.length %}
        {% for tag in page.tags.toArray() %}
          <span class="index-tag"># {{ tag.name }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="post-body">
    {{ page.content }}
  </div>

  {% if page.prev or page.next %}
    <div class="pagination" style="justify-content:space-between; padding-top:30px;">
      {% if page.prev %}
        <a href="{{ url_for(page.prev.path) }}">← {{ page.prev.title }}</a>
      {% else %}
        <span></span>
      {% endif %}
      {% if page.next %}
        <a href="{{ url_for(page.next.path) }}">{{ page.next.title }} →</a>
      {% endif %}
    </div>
  {% endif %}

{% endblock %}
